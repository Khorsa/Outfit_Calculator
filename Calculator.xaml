<Window x:Class="Calculator.CalculatorForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator"
        mc:Ignorable="d"
        Title="{ DynamicResource Calculator }" Height="300" Width="250" WindowStyle="ToolWindow" 
        KeyUp="Window_KeyUp"
        SizeChanged="Window_SizeChanged" Activated="Window_Activated" 
        >

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Calculator;component/Languages/lang.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="13,0,13,0" VerticalAlignment="Center">
            <StackPanel Cursor="Hand">
                <TextBlock FontSize="14" HorizontalAlignment="Right" Text="" x:Name="LastHistoryItemText" MouseLeftButtonDown="LastHistoryItemText_MouseLeftButtonDown" />
                <StackPanel.ContextMenu>
                    <ContextMenu x:Name="StatusHistorySelector" />
                </StackPanel.ContextMenu>
            </StackPanel>
        </Grid>

        <Grid Margin="10,0,10,10" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Grid.Column="0" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" Grid.ColumnSpan="5" x:Name="ResultBox" TextWrapping="NoWrap" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontFamily="Verdana" IsReadOnly="True" Text="" TextChanged="ResultBox_TextChanged"/>

            <Button Grid.Row="1" Grid.Column="0" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">←</Button>
            <Button Grid.Row="1" Grid.Column="1" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click" Background="#FFDDDDDD" Foreground="Red">C</Button>
            <Button Grid.Row="1" Grid.Column="2" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">/</Button>
            <Button Grid.Row="1" Grid.Column="3" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">×</Button>
            <Button Grid.Row="1" Grid.Column="4" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">–</Button>
            <Button Grid.Row="2" Grid.Column="0" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">Ln</Button>
            <Button Grid.Row="2" Grid.Column="1" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">7</Button>
            <Button Grid.Row="2" Grid.Column="2" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">8</Button>
            <Button Grid.Row="2" Grid.Column="3" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">9</Button>
            <Button Grid.Row="2" Grid.Column="4" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click" Grid.RowSpan="2">+</Button>
            <Button Grid.Row="3" Grid.Column="0" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click" Content="⅟ x"/>
            <Button Grid.Row="3" Grid.Column="1" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">4</Button>
            <Button Grid.Row="3" Grid.Column="2" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">5</Button>
            <Button Grid.Row="3" Grid.Column="3" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">6</Button>
            <Button Grid.Row="4" Grid.Column="0" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">x²</Button>
            <Button Grid.Row="4" Grid.Column="1" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">1</Button>
            <Button Grid.Row="4" Grid.Column="2" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">2</Button>
            <Button Grid.Row="4" Grid.Column="3" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">3</Button>
            <Button Grid.Row="4" Grid.Column="4" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click" Grid.RowSpan="2">=</Button>
            <Button Grid.Row="5" Grid.Column="0" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">√</Button>
            <Button Grid.Row="5" Grid.Column="1" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">±</Button>
            <Button Grid.Row="5" Grid.Column="2" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">0</Button>
            <Button Grid.Row="5" Grid.Column="3" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14" IsTabStop="False" Click="Button_Click">.</Button>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem Cursor="Hand">
                <TextBlock x:Name="StatusRoundText" Text="{ DynamicResource RoundTo }" Padding="5 0 0 0" />
                <StatusBarItem.ContextMenu>
                    <ContextMenu x:Name="StatusRoundSelector">
                        <MenuItem Header="0" Click="RoundItem_Click"/>
                        <MenuItem Header="1" Click="RoundItem_Click"/>
                        <MenuItem Header="2" Click="RoundItem_Click"/>
                        <MenuItem Header="3" Click="RoundItem_Click"/>
                        <MenuItem Header="4" Click="RoundItem_Click"/>
                        <MenuItem Header="5" Click="RoundItem_Click"/>
                        <MenuItem Header="6" Click="RoundItem_Click"/>
                        <MenuItem Header="7" Click="RoundItem_Click"/>
                        <MenuItem Header="8" Click="RoundItem_Click"/>
                        <MenuItem Header="9" Click="RoundItem_Click"/>
                        <MenuItem IsChecked="True" Header="10" Click="RoundItem_Click"/>
                    </ContextMenu>
                </StatusBarItem.ContextMenu>
            </StatusBarItem>

            <StatusBarItem Cursor="Hand" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusSettings" Text="{ DynamicResource Settings }" Padding="0 0 5 0" />
                <StatusBarItem.ContextMenu>
                    <ContextMenu x:Name="StatusSettingsSelector">
                        <MenuItem IsCheckable="True" Header="{DynamicResource CopyResultToClipboard}" Tag="copyResultToClipboard" Click="StatusSettings_Click"/>
                    </ContextMenu>
                </StatusBarItem.ContextMenu>
            </StatusBarItem>
        </StatusBar>

    </Grid>


</Window>
